  originalText: "\u0639\u0650\u0634 \u0623\u062C\u0648\u0627\u0621 \u0645\u0647\u0631\u062C\u0627\u0646
    \u0627\u0644\u062A\u0645\u0648\u0631 \u0641\u064A \u0627\u0644\u0642\u0635\u064A\u0645
    \u0648\u0633\u0627\u0639\u062F \u0627\u0644\u0644\u0627\u0639\u0628 \u0641\u064A
    \u062A\u062D\u062F\u064A\u062F \u0633\u0639\u0631 \u0627\u0644\u062A\u0645\u0631
    \u0627\u0644\u0635\u062D\u064A\u062D \u0644\u0643\u0644 \u0632\u0628\u0648\u0646.
    \u0645\u0646 \u062E\u0644\u0627\u0644 \u0647\u0630\u0627 \u0627\u0644\u062A\u062D\u062F\u064A
    \u062A\u062A\u0639\u0644\u0645 \u0645\u0641\u0647\u0648\u0645 \u0627\u0644\u062C\u0645\u0644
    \u0627\u0644\u0634\u0631\u0637\u064A\u0629 (If Statement)\u060C \u0648\u0643\u064A\u0641
    \u064A\u062E\u062D\u0630 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062C \u0642\u0631\u0627\u0631\u0627\u062A
    \u0645\u062E\u062A\u0644\u0641\u0629 \u062D\u0633\u0628 \u0627\u0644\u0634\u0631\u0637\u060C
    \u0644\u064A\u0639\u0645\u0644 \u0628\u0630\u0643\u0627\u0621 \u0648\u064A\u062A\u0641\u0627\u0639\u0644
    \u0645\u0639 \u0627\u0644\u0645\u0648\u0627\u0642\u0641 \u0627\u0644\u0645\u062A\u0646\u0648\u0639\u0629."
  fixTags: 1
  forceFix: 0
