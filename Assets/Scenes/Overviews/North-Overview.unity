  originalText: "\u0627\u0646\u0637\u0644\u0642 \u0641\u064A \u062A\u062D\u062F\u064A
    \u0627\u0639\u062F\u0627\u062F \u0627\u0644\u0642\u0647\u0648\u0629 \u0627\u0644\u0633\u0639\u0648\u062F\u064A\u0629
    \u0627\u0644\u0627\u0635\u064A\u0644\u0629 \u0641\u064A \u062E\u064A\u0645\u0647
    \u0634\u062A\u0648\u064A\u0629, \u062D\u064A\u062B \u064A\u062C\u0628 \u0639\u0644\u064A\u0645
    \u0645\u0633\u0627\u0639\u062F\u0629 \u0646\u0627\u064A\u0641 \u0639\u0644\u0649
    \u062A\u0631\u062A\u064A\u0628 \u062E\u0637\u0648\u0627\u062A \u0627\u0644\u0648\u0635\u0641\u0629
    \u062E\u0637\u0648\u0629 \u0628\u062E\u0637\u0648\u0629. \u062A\u062A\u0639\u0644\u0645
    \u0645\u0646 \u062E\u0644\u0627\u0644 \u0647\u0630\u0647 \u0627\u0644\u0631\u062D\u0644\u0629
    \u0627\u0646 \u0627\u0644\u062A\u0633\u0644\u0633\u0644 \u0647\u0648 \u0627\u0633\u0627\u0633
    \u0646\u062C\u0627\u062D \u0627\u0644\u0628\u0631\u0645\u062C\u0629, \u0627\u0630
    \u064A\u062C\u0628 \u062A\u0646\u0641\u064A\u0630 \u0627\u0644\u0627\u0648\u0627\u0645\u0631
    \u0628\u0627\u0644\u062A\u0631\u062A\u064A\u0628 \u0627\u0644\u0635\u062D\u064A\u062D
    \u0644\u0627\u0646\u062C\u0627\u0632 \u0627\u0644\u0645\u0647\u0645\u0629 \u0628\u0646\u062C\u0627\u062D."
  fixTags: 1
  forceFix: 0
